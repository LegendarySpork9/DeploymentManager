@page "/login"
@layout BlankLayout

<PageTitle>Login</PageTitle>

<div class="login-card card">
    <div class="card-body p-4">
        <h3 class="text-center mb-4 login-title">Deployment Manager</h3>
        <p class="text-center text-muted mb-4">Sign in to the Portal</p>

        <EditForm
            Model="LoginInformation"
            OnSubmit="HandleLogin"
            FormName="login">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input
                    @bind="LoginInformation.Username"
                    @bind:event="oninput"
                    class="form-control @(string.IsNullOrEmpty(LoginInformation.Username) ? "" : "valid modified")"
                    placeholder="Enter username" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input
                    @bind="LoginInformation.Password"
                    @bind:event="oninput"
                    class="form-control @(string.IsNullOrEmpty(LoginInformation.Password) ? "" : "valid modified")"
                    type="password"
                    placeholder="Enter password" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger py-2" role="alert">
                    @ErrorMessage
                </div>
            }

            <button type="submit" class="btn btn-primary w-100 mt-2" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Sign In
            </button>
        </EditForm>
    </div>
</div>
